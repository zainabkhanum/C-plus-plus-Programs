#include <iostream>
using namespace std;
int main()
{
	double dis=450;
	double avg=15;
	double pp, pr, ttex;
	cout<<"Enter Petrol Price: ";
	cin>>pp;
	pr=dis/avg;
	ttex=pp*pr;
	cout<<"Petrol Price: "<<pp<<endl;
	cout<<"Total Distance: "<<dis<<endl;
	cout<<"Average of Car per Litre: "<<avg<<endl;
	cout<<"Petrol Required: "<<pr<<" litre "<<endl;
	cout<<"Total Travelling Expense: "<<ttex;
	return 0;
}
