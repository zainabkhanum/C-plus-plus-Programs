#include <iostream>
using namespace std;
int main()
{
	string n1, n2, n3;
	double p1, p2, p3, q1, q2, q3, t1, t2, t3, grndt;
	// PRODUCT 01
	cout<<"Enter Product 1 Name: ";
	cin>>n1;
	cout<<"Enter its Price: ";
	cin>>p1;
	cout<<"Enter its Quantity: ";
	cin>>q1;
	// PRODUCT 02
	cout<<"Enter Product 2 Name: ";
	cin>>n2;
	cout<<"Enter its Price: ";
	cin>>p2;
	cout<<"Enter its Quantity: ";
	cin>>q2;
	// PRODUCT 03
	cout<<"Enter Product 3 Name: ";
	cin>>n3;
	cout<<"Enter its Price: ";
	cin>>p3;
	cout<<"Enter its Quantity: ";
	cin>>q3;
	// CALCULATIONS
	t1=p1*q1;
	t2=p2*q2;
	t3=p3*q3;
	grndt=t1+t2+t3;
	// TOTAL BILL
	cout<<n1<<" : "<<p1<<" x "<<q1<<" = "<<t1<<endl;
	cout<<n2<<" : "<<p2<<" x "<<q2<<" = "<<t2<<endl;
	cout<<n3<<" : "<<p3<<" x "<<q3<<" = "<<t3<<endl;
	cout<<"------------------------"<<endl;
	cout<<"Grand Total = "<<grndt;
	return 0;
}
